<Project>

  <!-- Settings shared by every .NET project in the repository. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--
    CI builds treat warnings as errors so new warnings never pile up.
    Local builds keep them as warnings so a stray warning does not block a debugging session.
    NuGet audit findings (NU1901-NU1904) stay visible but non-blocking: a newly disclosed
    vulnerability in a transitive package should be reviewed, not break every build at once.
  -->
  <PropertyGroup Condition="'$(CI)' == 'true'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
