<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests that host the API in memory against a real PostgreSQL started by Testcontainers. Needs Docker. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Logs submitted by the run tests. orders-api-40.log is the unit tests' copy, so both test the same lines. -->
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\LogAnalyzer.UnitTests\Fixtures\logs\orders-api-40.log" Link="Fixtures\logs\orders-api-40.log" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="WireMock.Net" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="xunit.v3.mtp-off" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LogAnalyzer.Api\LogAnalyzer.Api.csproj" />
  </ItemGroup>

</Project>
