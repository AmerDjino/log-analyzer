<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Golden-set evals for the [eval] scenarios: behavior that depends on model judgment.
    They call the real model and cost money, so CI runs them in a separate manual or nightly job,
    never on pull requests. The harness and the first cases arrive with add-claude-integration.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="xunit.v3.mtp-off" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LogAnalyzer.Core\LogAnalyzer.Core.csproj" />
  </ItemGroup>

</Project>
