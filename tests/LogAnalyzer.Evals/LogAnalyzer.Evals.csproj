<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Golden-set evals for the [eval] scenarios: behavior that depends on model judgment. They call the real model and
    cost money, so they run only on demand, on a developer's machine, with RUN_EVALS=1 and the developer's own key.
    CI never runs them and holds no key. GoldenLogTests needs no key and checks the committed logs.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Cases\**\*.json;GoldenLogs\**\*.log" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="xunit.v3.mtp-off" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LogAnalyzer.Core\LogAnalyzer.Core.csproj" />
    <ProjectReference Include="..\..\src\LogAnalyzer.Infrastructure\LogAnalyzer.Infrastructure.csproj" />
  </ItemGroup>

</Project>
