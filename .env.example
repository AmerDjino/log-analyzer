# Copy this file to .env (git-ignored) and adjust the values.
# Docker Compose reads .env automatically.

# Password for the local PostgreSQL container. Local development only.
POSTGRES_PASSWORD=change-me-local-only

# Host ports. Change them if something else on your machine already uses one.
POSTGRES_PORT=5432
API_PORT=5080
WEB_PORT=8080

# Development exposes the OpenAPI document at /openapi/v1.json.
ASPNETCORE_ENVIRONMENT=Development

# The model that analyzes runs: StandIn (no key, no network) or Claude.
MODEL_PROVIDER=StandIn

# Your Anthropic API key, needed only with MODEL_PROVIDER=Claude. Put it in .env, which git ignores, never here.
ANTHROPIC_API_KEY=
