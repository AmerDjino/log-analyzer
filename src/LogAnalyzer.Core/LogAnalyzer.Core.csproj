<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Domain types, validation and orchestration.
    This project must not reference any other project or any infrastructure package
    (database, HTTP, model SDK), so its logic stays testable without a network or database.
    LogAnalyzer.UnitTests guards this rule.
  -->

  <ItemGroup>
    <!-- The output contract. Embedded, so the validator (and later the model gateway) uses exactly this file. -->
    <EmbeddedResource Include="..\..\schemas\analysis-result.schema.json"
                      LogicalName="LogAnalyzer.Core.Contract.analysis-result.schema.json"
                      Link="Contract\analysis-result.schema.json" />
  </ItemGroup>

</Project>
